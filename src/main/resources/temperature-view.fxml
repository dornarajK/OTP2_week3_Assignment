<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.TemperatureController" prefWidth="440" prefHeight="760">
    <content>
        <VBox fx:id="root" spacing="10" alignment="CENTER" prefWidth="420" prefHeight="740">
            <Label fx:id="appTitleLabel" text="Temperature Converter" />
            <Label fx:id="languageLabel" text="Select language" />
            <ComboBox fx:id="languageBox" />
            <Label fx:id="temperatureLabel" text="Enter Temperature" />
            <TextField fx:id="temperatureInput" />
            <Label fx:id="conversionLabel" text="Your choice:" />
            <ComboBox fx:id="conversionBox" />
            <Button fx:id="convertButton" text="Convert" onAction="#handleConvert" />
            <Label fx:id="resultLabel" text="Result will appear here" wrapText="true" />
            <Label fx:id="historyLabel" text="Conversion history" />
            <ListView fx:id="conversionHistoryListView" prefWidth="400" prefHeight="150" />
            <Label fx:id="journeyLabel" text="Saved Journeys" />
            <ListView fx:id="journeyListView" prefWidth="400" prefHeight="110" />
            <Label fx:id="journeyInputLabel" text="Journey Database" />
            <TextField fx:id="distanceInput" promptText="Enter distance (km)" />
            <TextField fx:id="travelTimeInput" promptText="Enter travel time (hours)" />
            <Button fx:id="saveJourneyButton" text="Save Journey" onAction="#saveJourney" />
            <Label fx:id="databaseResultLabel" wrapText="true" />
        </VBox>
    </content>
</ScrollPane>
